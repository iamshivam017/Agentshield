# Application
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://agentshield:agentshield@localhost:5432/agentshield

# Optional Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=replace-with-local-development-secret

# LLM provider (optional for core risk decisions)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Razorpay Test Mode only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

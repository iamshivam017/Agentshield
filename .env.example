# Application
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Server-side web proxy target. Keep operator credentials server-only.
AGENTSHIELD_API_URL=http://localhost:8000
AGENTSHIELD_OPERATOR_API_KEY=
AGENTSHIELD_OPERATOR_ID=dashboard-operator

# Database
DATABASE_URL=postgresql+psycopg://agentshield:agentshield@localhost:5432/agentshield

# Optional Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=replace-with-local-development-secret
AGENT_API_KEY=
REQUIRE_AGENT_AUTH=false
# Production/staging: configure dedicated least-privilege operator keys.
OPERATOR_API_KEY=
OPERATOR_ADMIN_API_KEY=
OPERATOR_ANALYST_API_KEY=
OPERATOR_VIEWER_API_KEY=
REQUIRE_OPERATOR_AUTH=false

# API abuse controls
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Risk model artifact
RISK_MODEL_ARTIFACT_PATH=
RISK_MODEL_ARTIFACT_SHA256=
RISK_MODEL_METADATA_PATH=
RISK_MODEL_VERSION=artifact-unversioned

# LLM provider (optional for core risk decisions)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Razorpay Test Mode only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
